{
  "name": "miszuk-family-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-05",
  "triggers": { "crons": ["0 13,14 * * *"] },
  "vars": {
    "NOTIFICATIONS_ENROLLMENT_ENABLED": "true",
    "NOTIFICATIONS_SENDING_ENABLED": "true",
    "NOTIFICATIONS_AUDIENCE": "active_accounts",
    "NOTIFICATIONS_ALLOWED_USER_IDS": "",
    "VAPID_SUBJECT": "mailto:bob@miszuk.com",
    "ACCESS_TEAM_DOMAIN": "broken-bush-7200.cloudflareaccess.com",
    "ACCESS_AUD": "2d6488c2019b05588c29467e0bd8173b74d46c437efd7225834e9a84090ef1c8",
    "VAPID_PUBLIC_KEY": "BM8388D3W-sOw0W7volF3YO3L-zAHpJkkmuFwdT9AuPOLx1urR4HIISwQEegLiYgFBFb_fUmrIs00PQTEQN-biI",
    "VAPID_KEY_ID": "miszuk-push-2026-09-30-v1"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [{"binding":"VEHICLE_ATTACHMENTS","bucket_name":"miszuk-family-vehicle-attachments"}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-db",
      "database_id": "e169664c-a4f8-4b6c-93ab-081bb3fe6c0c"
    }
  ]
}
