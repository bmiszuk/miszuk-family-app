{
  "name": "miszuk-family-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "deploy": "npm run check && wrangler deploy",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev --local --ip 127.0.0.1 --var LOCAL_DEV:true",
    "preview:portable": "npm run build && node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply family-db --local",
    "db:remote:list": "wrangler d1 migrations list family-db --remote",
    "db:remote:apply": "wrangler d1 migrations apply family-db --remote"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "jose": "^6.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "miniflare": "^4.20260701.0",
    "vite": "^8.1.1",
    "wrangler": "^4.107.0"
  }
}
